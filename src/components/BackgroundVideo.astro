---
import Icon from './icons/Icon.astro';
import { resolveVideo } from '../lib/public-media';
import { site } from '../content/site';

interface Props {
  /** Nome-base em public/media (ex.: "metodo" → metodo.webm, metodo.mp4, metodo-poster.jpg). */
  name: string;
}

const { ui } = site;
const video = resolveVideo(Astro.props.name);
const hasMedia = video.sources.length > 0 || video.poster !== undefined;
const hasPauseControl = video.sources.length > 0;
---

{hasMedia && (
  <div class="bg-video-root" data-video-root>
    <div class="bg-video" aria-hidden="true">
      <video
        class="bg-video__media"
        muted
        loop
        playsinline
        preload="none"
        data-lazy-video
        data-poster={video.poster}
      >
        {video.sources.map((source) => (
          <source data-src={source.src} type={source.type} />
        ))}
      </video>
    </div>
    {hasPauseControl && (
      <button type="button" class="bg-video__toggle" aria-pressed="false" data-video-toggle>
        <Icon name="pause" size={18} class="bg-video__icon bg-video__icon--pause" />
        <Icon name="play" size={18} class="bg-video__icon bg-video__icon--play" />
        <span class="sr-only">{ui.pauseVideo}</span>
      </button>
    )}
  </div>
)}

<style>
  /* `display: contents`: o wrapper não gera caixa própria nem contexto de empilhamento — o vídeo
     (aria-hidden) e o botão de pausa (fora do aria-hidden) se comportam como filhos diretos da
     seção, preservando o z-index negativo do vídeo sob o véu. Serve só de escopo para o script. */
  .bg-video-root {
    display: contents;
  }

  .bg-video {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }

  .bg-video__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Fica perto do topo da seção (não do rodapé): o vídeo é decorativo e a seção pode ser alta
     (passos do método empilhados) — o botão precisa estar visível assim que a seção aparece,
     junto do eyebrow/título, sem exigir rolar até o fim para alcançá-lo. */
  .bg-video__toggle {
    display: none;
    position: absolute;
    z-index: 1;
    right: var(--space-6);
    top: var(--space-6);
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: var(--surface-raised);
    color: var(--ink);
  }

  .bg-video__toggle :global(.bg-video__icon--play),
  .bg-video__toggle[aria-pressed='true'] :global(.bg-video__icon--pause) {
    display: none;
  }

  .bg-video__toggle[aria-pressed='true'] :global(.bg-video__icon--play) {
    display: block;
  }

  /* Abaixo de 768px o vídeo não baixa nem toca (lazy-video.ts) — o botão também não aparece. */
  @media (min-width: 768px) {
    .bg-video__toggle {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-video__toggle {
      display: none;
    }
  }
</style>

<script>
  import '../scripts/lazy-video';
</script>
